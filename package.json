{
  "name": "superport-portfolio-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Cockpit for Jira Cloud by SUPERPORT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "golden": "node --test tests/goldenLotse.test.js",
    "perf": "node --expose-gc --test --test-concurrency=1 --test-timeout=1800000 tests/perf/perf.test.js",
    "bigdata": "node tools/bigDataset.js",
    "build:ui": "npm --prefix static/cockpit run build",
    "deploy": "npm run build:ui && forge deploy -e development --non-interactive"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/kvs": "^2.1.1",
    "@forge/llm": "^1.0.9",
    "@forge/resolver": "^2.0.2"
  }
}
